{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Django Runserver",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/manage.py",
        "args": ["runserver", "--noreload"],
        "django": true,
        "justMyCode": true
      },
      {
        "name": "Django Tests",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder}/manage.py",
        "args": ["test"],
        "django": true
      }
    ]
  }
  